{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/tracker/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": false,
    "tsConfigPath": "apps/tracker/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/tracker",
  "projects": {
    "tracker": {
      "type": "application",
      "root": "apps/tracker",
      "entryFile": "main",
      "sourceRoot": "apps/tracker/src",
      "compilerOptions": {
        "tsConfigPath": "apps/tracker/tsconfig.app.json"
      }
    },
    "location": {
      "type": "application",
      "root": "apps/location",
      "entryFile": "main",
      "sourceRoot": "apps/location/src",
      "compilerOptions": {
        "tsConfigPath": "apps/location/tsconfig.app.json"
      }
    },
    "auth": {
      "type": "application",
      "root": "apps/auth",
      "entryFile": "main",
      "sourceRoot": "apps/auth/src",
      "compilerOptions": {
        "tsConfigPath": "apps/auth/tsconfig.app.json"
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    }
  }
}
